# Neon → project → Connect → "Pooled connection" string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Optional: direct (unpooled) string, used for migrations if present
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Password you type on the login screen
APP_PASSWORD=change-me
# Random string ≥ 32 chars:  openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string-of-at-least-32-chars

# Optional
APP_TIME_ZONE=Europe/Madrid
STEPS_GOAL=10000
WEEKLY_RUN_KM_GOAL=15

# Local development with `docker compose up -d`:
# DATABASE_URL=postgres://postgres:postgres@db.localtest.me:5432/gymweb

# Lyfta API key (https://my.lyfta.app/community/api) and secret for the scheduled sync endpoint
LYFTA_API_KEY=
# Random string ≥ 16 chars; Vercel Cron sends it automatically as a Bearer token
CRON_SECRET=

# Google Health (steps and weight): OAuth client of type "Web application".
# Redirect URI to register: https://<your-domain>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: force the redirect URI (default: the request origin + /api/google/callback)
# GOOGLE_REDIRECT_URI=
